<%--
  데이터 업데이트 모달 (2차 지시문 E, 시안 : design_WellFAIR/데이터업데이트_모달_실행중.png · _완료.png)
  header.jspf 끝에서 include (서울시청 계정만). 동작은 js/dataupdate-modal.js, 모양은 common.css 의 .du-*
  상태 3가지 : 대기(#duIdle) / 실행 중 · 완료(#duRun, 완료면 .du-modal 에 done)
--%>
<div class="du-bg" id="duModal" role="dialog" aria-modal="true" aria-labelledby="duTitle">
  <div class="du-modal">
    <div class="du-head">
      <span class="du-head-ico"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 0 0-14.3-4.4L4 8.5"/><path d="M4 4v4.5h4.5"/><path d="M4 13a8 8 0 0 0 14.3 4.4l1.7-1.9"/><path d="M20 20v-4.5h-4.5"/></svg></span>
      <div class="du-head-txt">
        <h3 id="duTitle">데이터 업데이트</h3>
        <p>원천 파일(건물·건축물대장·침수흔적도 등) 중 바뀐 것만 다시 읽어 건물 데이터를 고칩니다.</p>
      </div>
      <button type="button" class="du-x" id="duX" aria-label="닫기"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>

    <div class="du-body">
      <p class="du-err" id="duErr" hidden></p>

      <%-- 대기 : 마지막 실행 결과 요약 --%>
      <div id="duIdle">
        <div class="du-last" id="duLast">마지막 실행 결과를 확인하는 중…</div>
      </div>

      <%-- 실행 중 · 완료 --%>
      <div id="duRun" hidden>
        <div class="du-prog-head"><b id="duStepNo"></b><span id="duStepNm"></span><strong id="duPct"></strong></div>
        <div class="du-track"><i class="du-bar" id="duBar"></i></div>
        <p class="du-mode" id="duMode"><span class="du-mode-tag" id="duModeTag"></span><span id="duModeTxt"></span></p>

        <%-- 완료 : 결과 한 줄 + 숫자 카드 --%>
        <div class="du-result" id="duResult" hidden></div>
        <div class="du-cards" id="duCards" hidden></div>

        <div class="du-cols">
          <div class="du-col du-col-steps">
            <div class="du-col-h"><b>진행 단계</b></div>
            <ul class="du-steps" id="duSteps"></ul>
          </div>
          <div class="du-col">
            <div class="du-col-h"><b id="duRightTitle">변경 사항</b><small id="duRightSub">실시간 · 아래로 쌓임</small></div>
            <div class="du-feed" id="duFeed"></div>
            <table class="du-sum" id="duSum" hidden></table>
          </div>
        </div>
      </div>
    </div>

    <div class="du-foot">
      <span class="du-note" id="duNote"></span>
      <button type="button" class="btn btn-line" id="duFull" data-tip="바뀐 것이 없어도 전부 다시 계산합니다 (약 3분)">전체 다시 계산</button>
      <button type="button" class="btn btn-primary" id="duStart">업데이트 시작</button>
      <button type="button" class="btn btn-line" id="duBg" hidden>백그라운드로 닫기</button>
      <button type="button" class="btn btn-line" id="duClose" hidden>닫기</button>
      <button type="button" class="btn btn-primary" id="duView" hidden><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5 9 4l6 2.5L20.5 4v13.5L15 20l-6-2.5L3.5 20V6.5z"/><path d="M9 4v13.5M15 6.5V20"/></svg><span id="duViewTxt"></span></button>
    </div>
  </div>
</div>
<script src="${pageContext.request.contextPath}/resources/js/dataupdate-modal.js"></script>
