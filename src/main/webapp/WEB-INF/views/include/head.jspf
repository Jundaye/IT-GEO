<%--
  공통 <head>. include 하기 전에 pageTitle 을 정한다 : <c:set var="pageTitle" value="로그인"/>
  화면별 css 가 있으면 pageCss 에 파일명만 : <c:set var="pageCss" value="login"/>
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- 정적 파일 버전 : css · js 를 고쳐서 올릴 때 이 값을 바꾸면 브라우저가 예전 파일(캐시)을 쓰지 않고 새로 받는다 --%>
<c:set var="assetVer" value="20261120c" scope="request"/>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="ctx" content="${pageContext.request.contextPath}/">
  <title><c:out value="${pageTitle}"/> | WellFAIR</title>
  <%-- 라이트 / 다크 : 저장해 둔 테마를 CSS 보다 먼저 붙여 깜빡임 없이 (헤더 테마 버튼 = common.js Common.setTheme) --%>
  <script>try { if (localStorage.getItem('wf-theme') === 'light') document.documentElement.setAttribute('data-theme', 'light'); } catch (e) {}</script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css?v=${assetVer}">
  <c:if test="${not empty pageCss}">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/${pageCss}.css?v=${assetVer}">
  </c:if>
  <c:if test="${not empty pageCss2}">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/${pageCss2}.css?v=${assetVer}">
  </c:if>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
